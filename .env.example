PORT=4000
NODE_ENV=development
DEPLOY_ENV=local
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/arcade_db?schema=public
REDIS_URL=redis://:PASSWORD@localhost:6379
JWT_SECRET=replace-with-a-long-random-string
ALLOW_DEMO_OTP=true
ENABLE_DEMO_LOGIN=false
# Public and staging copies must stay false. Non-public test processes can still run synthetic flows.
ENABLE_REGULATED_FEATURES=false
# Leave blank until the data owner approves a retention period. Do not invent one.
SCREENSHOT_RETENTION_DAYS=
# Process-local rate limits are not distributed protection. Leave unset so sign-in fails closed without Redis.
ALLOW_MEMORY_RATE_LIMIT=
AGENT_PHONE=
AGENT_PASSWORD=
# Optional local test receiver. Leave blank for no delivery. A loopback URL is not an external notification.
ALERT_WEBHOOK_URL=
ADMIN_PHONE=YOUR_10_DIGIT_ADMIN_PHONE
ADMIN_PASSWORD=replace-me
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
VITE_API_URL=
VITE_PLAYER_URL=http://localhost:5174
VITE_ENABLE_DEMO_LOGIN=false
CAPACITOR_SERVER_URL=
# Test-only deterministic OTP; never set this in staging or production:
# NODE_ENV=test
# TEST_OTP=654321
#
# Any public deployment refuses to boot until these are real:
# DEPLOY_ENV=staging
# ALLOW_DEMO_OTP=false
# ENABLE_DEMO_LOGIN=false
# ENABLE_REGULATED_FEATURES=false until independent release authorization
# SMS_PROVIDER=FAST2SMS or MSG91, with that key set
# CORS_ORIGINS=https://your-domain
# ADMIN_PASSWORD at least 12 characters, not the local desk password
# JWT secrets that are not the local defaults
SMS_PROVIDER=
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
