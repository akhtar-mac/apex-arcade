PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/arcade_db?schema=public
REDIS_URL=redis://:PASSWORD@localhost:6379
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ALLOW_DEMO_OTP=true
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=replace-me
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
VITE_API_URL=
CAPACITOR_SERVER_URL=
# Production refuses to boot until these are real:
# ALLOW_DEMO_OTP=false
# SMS_PROVIDER=FAST2SMS or MSG91, with that key set
# CORS_ORIGINS=https://your-domain
# ADMIN_PASSWORD at least 12 characters, not the local desk password
# JWT secrets that are not the local defaults
SMS_PROVIDER=
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
